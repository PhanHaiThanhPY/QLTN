# ── Service ─────────────────────────────────────────────────────────────
SERVICE_PORT=5300
CONFIG_ENV_MODE=development
# ERROR | WARN | INFO | DEBUG | VERBOSE
CONFIG_LOGGER_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (empty = same-origin only)
CORS_ORIGINS=http://localhost:5173
# Business timezone for calendar dates
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ── PostgreSQL (required) ────────────────────────────────────────────────
CONFIG_POSTGRES_HOST_QLTN=localhost
CONFIG_POSTGRES_PORT_QLTN=5434
CONFIG_POSTGRES_DB_QLTN=qltn_dev
CONFIG_POSTGRES_USER_QLTN=qltn
CONFIG_POSTGRES_PASSWORD_QLTN=

# Stop boot when a migration file fails (keep true outside local experiments)
MIGRATION_FAIL_FAST=true

# ── File storage (optional) ──────────────────────────────────────────────
# Directory for uploaded file content; relative paths resolve from the api-qltn folder.
STORAGE_DIR=storage

# ── Auth (required) ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CONFIG_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7

# ── Demo seed (development only; refused when CONFIG_ENV_MODE=production) ──
SEED_DEMO_DATA=true
# Password given to every seeded demo account (required when SEED_DEMO_DATA=true)
SEED_DEMO_PASSWORD=
