# Nguồn dữ liệu của web: mock (IndexedDB demo, mặc định) | api (api-qltn thật)
VITE_DATA_SOURCE=mock

# Gốc API khi VITE_DATA_SOURCE=api. Mặc định /api, dev server proxy sang http://localhost:5300
VITE_API_BASE_URL=/api

# Dev only: prefill of the api-mode login form (npm run dev). Put the values in web/.env.local (git-ignored), never
# here; a production build drops them.
VITE_DEV_LOGIN_USERNAME=
VITE_DEV_LOGIN_PASSWORD=
